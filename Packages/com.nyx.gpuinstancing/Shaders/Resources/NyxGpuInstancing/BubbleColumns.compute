// Culling GPU + simulation analytique des bulles (comportement BubbleColumns.cs).
// Aucune donnée n'est renvoyée par le CPU à chaque frame : la position est une fonction du temps.
// NyxBuildBubbles construit les bulles des colonnes en boucle à chaque reconstruction (BubbleColumns.BuildInstancesOnGpu).
#pragma kernel NyxCull
#pragma kernel NyxWriteArgs
#pragma kernel NyxBuildBubbles

#include "../../ShaderLibrary/InstancingData.hlsl"
#include "../../ShaderLibrary/OceanWaves.hlsl"

float  _NyxTime;
float4 _BubbleShape;   // x : aplatissement max, y : rayon (m) d'aplatissement max, z : vitesse d'oscillation (rad/s), w : distance d'éclatement (m)
float4 _BubbleTiming;  // x : durée d'apparition (s)

// Disposition écrite par BubbleColumns.cs :
//   row0 : xyz = point d'émission (monde), w = instant d'émission (s)
//   row1 : x = rayon en surface (m), y = vitesse de montée (m/s), z = durée de vie ou période (s), w = 1 boucle / 0 ponctuelle
//   row2 : x = rayon de la spirale (m), y = tours par seconde, z = graine 0..1
//   custom.w = variante (0)
bool NyxEvaluateInstance(uint index, NyxInstanceData src, out NyxRenderData dst)
{
    dst = (NyxRenderData)0;

    float period = src.row1.z;
    float age = _NyxTime - src.row0.w;
    if (src.row1.w > 0.5)
        age -= period * floor(age / period);        // boucle infinie (modulo positif)
    if (age < 0 || age >= period)
        return false;

    // Montée en spirale (les bulles de quelques mm zigzaguent / spiralent)
    float seed = src.row2.z;
    float s, c;
    sincos(6.28318530718 * (src.row2.y * age + seed), s, c);
    float3 position = src.row0.xyz;
    position.y += src.row1.y * age;
    position.xz += float2(c, s) * src.row2.x;

    // Éclate en atteignant la surface (vagues comprises)
    float depth = NyxWaveHeight(position.xz, _NyxWaveTime) - position.y;
    if (depth <= 0)
        return false;

    // Loi de Boyle : V ~ 1/P avec P(d) = 1 + d / 10,33 atm, donc r = r_surface * (1 + d / 10,33)^(-1/3).
    // Une bulle qui part de 20 m arrive en surface avec un rayon x1,44.
    float radius = src.row1.x * pow(1.0 + depth * (1.0 / 10.33), -1.0 / 3.0);

    // Apparition (grossit en _BubbleTiming.x secondes) et éclatement (rétrécit sur les derniers cm)
    float pop = saturate(depth / max(_BubbleShape.w, 1e-3));
    radius *= saturate(age / max(_BubbleTiming.x, 1e-3)) * pop;
    if (radius < 1e-5)
        return false;

    // Forme : ellipsoïde aplati qui oscille, d'autant plus que la bulle est grosse
    float flatness = _BubbleShape.x * saturate(radius / max(_BubbleShape.y, 1e-4));
    flatness *= 0.75 + 0.25 * sin(_NyxTime * _BubbleShape.z + seed * 40.0);
    float horizontal = radius * (1.0 + 0.5 * flatness);
    float vertical   = radius * (1.0 - flatness);

    dst.row0 = float4(horizontal, 0, 0, position.x);
    dst.row1 = float4(0, vertical, 0, position.y);
    dst.row2 = float4(0, 0, horizontal, position.z);
    dst.custom = float4(seed, age / period, depth, pop);   // w : opacité utilisée par le shader
    return true;
}

#include "../../ShaderLibrary/InstancingCulling.hlsl"

// ------------------------------------------------------------------------------------------------------------------
// Construction des colonnes en boucle, à la reconstruction : 1 thread par bulle, écrite directement dans _NyxInstances.
// Mêmes tirages, dans le même ordre, que l'ancien job Burst du CPU : graine du comportement, émetteur, rang dans la colonne.
// Les bulles suivantes (tampon des émissions ponctuelles) sont envoyées par le CPU.
#include "../../ShaderLibrary/InstancingRandom.hlsl"

// = BubbleColumns.Column (C#), 52 octets
struct NyxBubbleColumn
{
    float3 origin;
    float  radius;
    float2 surfaceRadius;
    float2 riseSpeed;
    float  spiralRadius;
    float  spiralFrequency;
    float  travel;           // jusqu'à la surface + creux max des vagues (m)
    int    firstInstance;    // première bulle de la colonne
    uint   emitterIndex;     // index dans la liste des émetteurs : graine stable si une autre colonne change
};

StructuredBuffer<NyxBubbleColumn> _BubbleColumns;   // débuts strictement croissants
uint _BubbleColumnCount;
uint _BubbleCount;           // bulles des colonnes
uint _BubbleSeed;

// Point uniforme dans le disque unité (= BubbleColumns.RandomInDisk)
float2 NyxRandomInDisk(inout NyxRandom random)
{
    float angle = NyxNextFloat(random) * 3.14159274 * 2.0;   // math.PI en float
    float distance = sqrt(NyxNextFloat(random));
    float s, c;
    sincos(angle, s, c);
    return float2(c, s) * distance;
}

[numthreads(NYX_THREADS, 1, 1)]
void NyxBuildBubbles(uint3 groupId : SV_GroupID, uint3 threadId : SV_GroupThreadID)
{
    uint index = (groupId.y * _NyxGroupsX + groupId.x) * NYX_THREADS + threadId.x;
    if (index >= _BubbleCount)
        return;

    // Colonne de cette bulle : dernière colonne qui commence avant elle
    uint low = 0;
    uint high = _BubbleColumnCount - 1;
    while (low < high)
    {
        uint middle = (low + high + 1) >> 1;
        if ((uint)_BubbleColumns[middle].firstInstance <= index)
            low = middle;
        else
            high = middle - 1;
    }
    NyxBubbleColumn column = _BubbleColumns[low];

    NyxRandom random = NyxCreateRandom(NyxHash3(uint3(_BubbleSeed, column.emitterIndex, index - (uint)column.firstInstance)) | 1u);
    float speed = max(column.riseSpeed.x + NyxNextFloat(random) * (column.riseSpeed.y - column.riseSpeed.x), 0.01);
    float period = column.travel / speed;
    float2 offset = NyxRandomInDisk(random) * column.radius;
    float spawnTime = -NyxNextFloat(random) * period;   // phase aléatoire : la colonne est pleine dès t = 0
    float surfaceRadius = column.surfaceRadius.x + NyxNextFloat(random) * (column.surfaceRadius.y - column.surfaceRadius.x);
    float spiralFrequency = column.spiralFrequency * (0.7 + NyxNextFloat(random) * (1.3 - 0.7));
    float seed = NyxNextFloat(random);

    // Disposition lue par NyxEvaluateInstance (plus haut) : bulle en boucle, variante 0
    NyxInstanceData data;
    data.row0 = float4(column.origin.x + offset.x, column.origin.y, column.origin.z + offset.y, spawnTime);
    data.row1 = float4(surfaceRadius, speed, period, 1);
    data.row2 = float4(column.spiralRadius, spiralFrequency, seed, 0);
    data.custom = float4(0, 0, 0, 0);
    _NyxInstances[index] = data;
}
