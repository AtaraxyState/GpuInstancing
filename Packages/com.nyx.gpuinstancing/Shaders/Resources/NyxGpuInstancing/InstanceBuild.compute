// Construction des instances sur GPU (MeshSpawner.Rebuild). Pas un comportement : ni NyxCull ni NyxWriteArgs ici.
//
// Placement (grille perturbée sur la boîte du polygone de la zone puis amas autour des ancres, ou liste), filtré par la
// zone, en 3 passes ; le CPU ne lit que quelques compteurs entre la 2e et la 3e, pour dimensionner le buffer d'instances :
//   NyxCountPlacements : 1 thread par candidat -> gardé ou non par la zone. Par groupe : masque des gardés (1 bit par
//                        candidat) et leur nombre. Pour tout le spawner : total, nombre par variante, boîte des positions,
//                        échelle max.
//   NyxScanGroups      : 1 seul groupe -> début de chaque groupe dans la sortie (somme des précédents).
//   NyxWriteInstances  : 1 thread par candidat gardé -> donnée d'instance (lacet + échelle + position) à son rang.
//   NyxWritePlacements : la même chose, mais écrit le placement (lu par le CPU : MeshSpawner.Placements).
// Le rang d'un candidat dans son groupe se lit dans le masque (countbits) : la sortie garde l'ordre des candidats quel que
// soit l'ordre d'exécution, et l'écriture ne refait pas le test de la zone (même décision qu'au comptage, toujours).
//
// NyxCountVariants : instances écrites par un comportement (C# ou GPU) -> nombre par variante ; une variante invalide
// devient la variante désactivée.
#pragma kernel NyxCountPlacements
#pragma kernel NyxScanGroups
#pragma kernel NyxWriteInstances
#pragma kernel NyxWritePlacements
#pragma kernel NyxCountVariants

#include "../../ShaderLibrary/InstancingData.hlsl"
#include "../../ShaderLibrary/InstancingRandom.hlsl"
#include "../../ShaderLibrary/InstancingZone.hlsl"

#define NYX_THREADS 64              // = MeshSpawner.ThreadGroupSize (comptage par variante)
#define NYX_PLACE_THREADS 256       // = MeshSpawner.PlaceThreadGroupSize
#define NYX_MASK_WORDS 8            // NYX_PLACE_THREADS / 32 : mots du masque d'un groupe
#define NYX_SCAN_THREADS 1024
#define NYX_MAX_VARIANTS 64         // = MeshSpawner.MaxVariants
#define NYX_STATS_VARIANTS 8        // _NyxBuildStats : [0] gardés, [1..3] min xyz, [4..6] max xyz, [7] échelle max, [8..] par variante

// = MeshPlacement (C#), 28 octets
struct NyxPlacement
{
    float3 position;
    float  yaw;
    float  scale;
    int    variant;
    float  seed;
};

uint _NyxGroupsX;                   // groupes en X (dispatch 2D au-delà de 65 535 groupes)

// Variantes
uint _NyxVariantCount;              // variantes du spawner
uint _NyxValidVariantsLow;          // bits des variantes dessinables (0..31, 32..63)
uint _NyxValidVariantsHigh;
uint _NyxDeadVariant;               // variante désactivée (= nombre de variantes)

// Placement
uint   _NyxPlaceCount;              // candidats
uint   _NyxPlaceGroupCount;         // groupes de NYX_PLACE_THREADS candidats
uint   _NyxPlaceFromList;           // 1 : candidats lus dans _NyxPlaceList ; 0 : grille puis amas
uint   _NyxPlaceGridCount;          // candidats [0, n) : grille ; ensuite : amas
uint   _NyxPlaceCellsX;
float4 _NyxPlaceGrid;               // xy : coin min (x, z) de la grille, zw : pas (x, z)
float4 _NyxPlaceShape;              // x : hauteur (face du haut), y : rayon des amas, z, w : échelle min, max
uint   _NyxPlaceSeed;
uint   _NyxPlaceClumps;             // amas par ancre
uint   _NyxPlaceRandomVariants;     // variantes tirées au hasard (au moins 1)
uint   _NyxPlaceTested;             // candidats [0, n) testés contre le polygone (grille d'une zone non rectangulaire)
uint   _NyxPlaceClip;               // 1 : tous les candidats testés contre le volume (polygone et hauteur)

StructuredBuffer<float4>            _NyxPlaceAnchors;      // xyz : ancres des amas
StructuredBuffer<NyxPlacement>      _NyxPlaceList;
RWStructuredBuffer<uint>            _NyxPlaceMask;         // NYX_MASK_WORDS par groupe : bit = candidat gardé
RWStructuredBuffer<uint>            _NyxPlaceGroups;       // gardés par groupe, puis (NyxScanGroups) début du groupe dans la sortie
RWStructuredBuffer<uint>            _NyxBuildStats;
RWStructuredBuffer<NyxInstanceData> _NyxBuildInstances;
RWStructuredBuffer<NyxPlacement>    _NyxBuildPlacements;

// Comptage par variante
uint _NyxBuildCount;

groupshared uint gs_Mask[NYX_MASK_WORDS];
groupshared uint gs_Kept;
groupshared uint gs_Variants[NYX_MAX_VARIANTS];
groupshared uint gs_Bounds[7];      // min xyz, max xyz (bits ordonnés), échelle max
groupshared uint gs_Scan[NYX_SCAN_THREADS];

bool NyxVariantValid(uint variant)
{
    uint bits = variant < 32 ? _NyxValidVariantsLow : _NyxValidVariantsHigh;
    return variant < _NyxVariantCount && ((bits >> (variant & 31)) & 1) != 0;
}

// Bits d'un flottant ordonnés comme des entiers non signés : min / max atomiques sur des flottants.
uint NyxOrderedBits(float value)
{
    uint bits = asuint(value);
    return (bits & 0x80000000u) != 0 ? ~bits : bits | 0x80000000u;
}

// Candidat 'index'. Procédural : mêmes tirages, dans le même ordre, que l'ancien job Burst du CPU (graine du spawner + index).
NyxPlacement NyxCandidate(uint index)
{
    NyxPlacement p;
    if (_NyxPlaceFromList != 0)
    {
        p = _NyxPlaceList[index];
        p.variant = clamp(p.variant, 0, (int)_NyxPlaceRandomVariants - 1);
        return p;
    }

    NyxRandom random = NyxCreateRandom(NyxHash2(uint2(_NyxPlaceSeed, index)) | 1u);
    if (index < _NyxPlaceGridCount)
    {
        uint x = index % _NyxPlaceCellsX;
        uint z = index / _NyxPlaceCellsX;
        float jitterX = NyxNextFloat(random);
        float jitterZ = NyxNextFloat(random);
        p.position = float3(_NyxPlaceGrid.x + ((float)x + jitterX) * _NyxPlaceGrid.z, _NyxPlaceShape.x,
                            _NyxPlaceGrid.y + ((float)z + jitterZ) * _NyxPlaceGrid.w);
    }
    else
    {
        float3 anchor = _NyxPlaceAnchors[(index - _NyxPlaceGridCount) / _NyxPlaceClumps].xyz;
        float angle = NyxNextFloat(random) * 3.14159274 * 2.0;    // math.PI en float
        float distance = _NyxPlaceShape.y * sqrt(NyxNextFloat(random));
        float s, c;
        sincos(angle, s, c);
        p.position = float3(anchor.x + c * distance, _NyxPlaceShape.x, anchor.z + s * distance);
    }
    p.yaw = NyxNextFloat(random) * 360.0;
    p.scale = _NyxPlaceShape.z + NyxNextFloat(random) * (_NyxPlaceShape.w - _NyxPlaceShape.z);   // math.lerp
    p.variant = (int)NyxNextInt(random, _NyxPlaceRandomVariants);
    p.seed = NyxNextFloat(random);
    return p;
}

// Gardé par la zone : la grille d'une zone non rectangulaire (ou à bord naturel) contre le bord ; avec le volume, tous les
// candidats contre le bord et la hauteur. Lisière : à moins de _NyxZoneNatural.z mètres du bord, un candidat sur deux,
// puis de moins en moins, est retiré (tirage propre au candidat, indépendant du placement). Placement procédural
// seulement : pour une liste (placement figé compris), _NyxZoneNatural.z vaut 0 et ses instances sont gardées.
bool NyxKeepCandidate(uint index, NyxPlacement p)
{
    bool inside = true;
    if (_NyxPlaceClip != 0)
        inside = p.position.y >= _NyxZoneHeight.x && p.position.y <= _NyxZoneHeight.y;
    if (inside && (_NyxPlaceClip != 0 || index < _NyxPlaceTested))
    {
        float edge = NyxZoneEdge(p.position.xz);
        inside = edge <= 0;
        if (inside && _NyxZoneNatural.z > 0)
        {
            uint h = NyxHash2(uint2(_NyxPlaceSeed ^ 0x9E3779B9u, index));
            inside = (h & 0xFFFFFFu) / 16777215.0 < saturate(-edge / _NyxZoneNatural.z);
        }
    }
    return inside;
}

// Donnée d'instance par défaut (= MeshSpawnerJobs.TrsInstance) : lacet + échelle + position, graine en custom.x.
// Une variante non dessinable devient la variante désactivée (jamais évaluée par le culling).
NyxInstanceData NyxPlacementInstance(NyxPlacement p)
{
    float s, c;
    sincos(p.yaw * 0.0174532925, s, c);   // math.radians
    NyxInstanceData data;
    data.row0 = float4(c * p.scale, 0, s * p.scale, p.position.x);
    data.row1 = float4(0, p.scale, 0, p.position.y);
    data.row2 = float4(-s * p.scale, 0, c * p.scale, p.position.z);
    data.custom = float4(p.seed, 0, 0, NyxVariantValid((uint)p.variant) ? (float)p.variant : (float)_NyxDeadVariant);
    return data;
}

[numthreads(NYX_PLACE_THREADS, 1, 1)]
void NyxCountPlacements(uint3 groupId : SV_GroupID, uint3 threadId : SV_GroupThreadID)
{
    uint t = threadId.x;
    if (t < NYX_MASK_WORDS)
        gs_Mask[t] = 0;
    if (t < NYX_MAX_VARIANTS)
        gs_Variants[t] = 0;
    if (t < 3)
    {
        gs_Bounds[t] = 0xFFFFFFFFu;
        gs_Bounds[t + 3] = 0;
    }
    if (t == 0)
    {
        gs_Kept = 0;
        gs_Bounds[6] = 0;
    }
    GroupMemoryBarrierWithGroupSync();

    uint group = groupId.y * _NyxGroupsX + groupId.x;
    uint index = group * NYX_PLACE_THREADS + t;
    if (index < _NyxPlaceCount)
    {
        NyxPlacement p = NyxCandidate(index);
        if (NyxKeepCandidate(index, p))
        {
            InterlockedOr(gs_Mask[t >> 5], 1u << (t & 31));
            InterlockedAdd(gs_Kept, 1);
            InterlockedAdd(gs_Variants[(uint)p.variant], 1);
            InterlockedMin(gs_Bounds[0], NyxOrderedBits(p.position.x));
            InterlockedMin(gs_Bounds[1], NyxOrderedBits(p.position.y));
            InterlockedMin(gs_Bounds[2], NyxOrderedBits(p.position.z));
            InterlockedMax(gs_Bounds[3], NyxOrderedBits(p.position.x));
            InterlockedMax(gs_Bounds[4], NyxOrderedBits(p.position.y));
            InterlockedMax(gs_Bounds[5], NyxOrderedBits(p.position.z));
            InterlockedMax(gs_Bounds[6], asuint(abs(p.scale)));
        }
    }
    GroupMemoryBarrierWithGroupSync();

    if (group >= _NyxPlaceGroupCount)
        return;   // groupe en trop du dispatch 2D (après la dernière barrière)
    if (t < NYX_MASK_WORDS)
        _NyxPlaceMask[group * NYX_MASK_WORDS + t] = gs_Mask[t];
    uint kept = gs_Kept;
    if (t == 0)
    {
        _NyxPlaceGroups[group] = kept;
        if (kept > 0)
            InterlockedAdd(_NyxBuildStats[0], kept);
    }
    if (kept == 0)
        return;
    if (t < 3)
    {
        InterlockedMin(_NyxBuildStats[1 + t], gs_Bounds[t]);
        InterlockedMax(_NyxBuildStats[4 + t], gs_Bounds[t + 3]);
    }
    else if (t == 3)
    {
        InterlockedMax(_NyxBuildStats[7], gs_Bounds[6]);
    }
    if (t < NYX_MAX_VARIANTS && gs_Variants[t] > 0)
        InterlockedAdd(_NyxBuildStats[NYX_STATS_VARIANTS + t], gs_Variants[t]);
}

// Somme des gardés des groupes précédents, pour chaque groupe (en place dans _NyxPlaceGroups). Un seul groupe : chaque
// thread additionne une suite de groupes, puis somme préfixe (Hillis-Steele) des 1 024 totaux en mémoire partagée.
[numthreads(NYX_SCAN_THREADS, 1, 1)]
void NyxScanGroups(uint3 threadId : SV_GroupThreadID)
{
    uint t = threadId.x;
    uint perThread = (_NyxPlaceGroupCount + NYX_SCAN_THREADS - 1) / NYX_SCAN_THREADS;
    uint begin = min(t * perThread, _NyxPlaceGroupCount);
    uint end = min(begin + perThread, _NyxPlaceGroupCount);
    uint sum = 0;
    for (uint i = begin; i < end; i++)
        sum += _NyxPlaceGroups[i];
    gs_Scan[t] = sum;
    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (uint offset = 1; offset < NYX_SCAN_THREADS; offset <<= 1)
    {
        uint add = t >= offset ? gs_Scan[t - offset] : 0;
        GroupMemoryBarrierWithGroupSync();
        gs_Scan[t] += add;
        GroupMemoryBarrierWithGroupSync();
    }

    uint running = gs_Scan[t] - sum;
    for (uint j = begin; j < end; j++)
    {
        uint count = _NyxPlaceGroups[j];
        _NyxPlaceGroups[j] = running;
        running += count;
    }
}

// Candidat 'index' gardé ? Si oui, 'output' = sa place dans la sortie (début du groupe + gardés avant lui dans le groupe).
bool NyxOutputIndex(uint3 groupId, uint t, out uint index, out uint output)
{
    uint group = groupId.y * _NyxGroupsX + groupId.x;
    index = group * NYX_PLACE_THREADS + t;
    output = 0;
    if (index >= _NyxPlaceCount)
        return false;
    uint first = group * NYX_MASK_WORDS;
    uint word = t >> 5;
    uint rank = 0;
    for (uint w = 0; w < word; w++)
        rank += countbits(_NyxPlaceMask[first + w]);
    uint bits = _NyxPlaceMask[first + word];
    uint bit = 1u << (t & 31);
    rank += countbits(bits & (bit - 1u));
    output = _NyxPlaceGroups[group] + rank;
    return (bits & bit) != 0;
}

[numthreads(NYX_PLACE_THREADS, 1, 1)]
void NyxWriteInstances(uint3 groupId : SV_GroupID, uint3 threadId : SV_GroupThreadID)
{
    uint index, output;
    if (NyxOutputIndex(groupId, threadId.x, index, output))
        _NyxBuildInstances[output] = NyxPlacementInstance(NyxCandidate(index));
}

[numthreads(NYX_PLACE_THREADS, 1, 1)]
void NyxWritePlacements(uint3 groupId : SV_GroupID, uint3 threadId : SV_GroupThreadID)
{
    uint index, output;
    if (NyxOutputIndex(groupId, threadId.x, index, output))
        _NyxBuildPlacements[output] = NyxCandidate(index);
}

[numthreads(NYX_THREADS, 1, 1)]
void NyxCountVariants(uint3 groupId : SV_GroupID, uint3 threadId : SV_GroupThreadID)
{
    uint t = threadId.x;
    gs_Variants[t] = 0;   // NYX_THREADS = NYX_MAX_VARIANTS
    GroupMemoryBarrierWithGroupSync();

    uint index = (groupId.y * _NyxGroupsX + groupId.x) * NYX_THREADS + t;
    if (index < _NyxBuildCount)
    {
        int variant = (int)_NyxBuildInstances[index].custom.w;
        if (variant >= 0 && NyxVariantValid((uint)variant))
            InterlockedAdd(gs_Variants[variant], 1);
        else
            _NyxBuildInstances[index].custom.w = (float)_NyxDeadVariant;
    }
    GroupMemoryBarrierWithGroupSync();

    if (gs_Variants[t] > 0)
        InterlockedAdd(_NyxBuildStats[NYX_STATS_VARIANTS + t], gs_Variants[t]);
}
